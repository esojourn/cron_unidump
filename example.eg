#--------------------------------------------------------#
# cron_unidump job config -> ~/.cron_unidump.d/<name>.conf
# <name> = letters, digits, _ or - only. It becomes the sub directory
# for this job's archives and logs.
# Keep private if it contains a password: chmod 600
#--------------------------------------------------------#

#------ Files (cron_unidump backup file <name>) ------#
SOURCE='/var/www/example'

# Paths to skip. Relative paths are relative to SOURCE; globs are allowed.
# Entries already written as tar options (--exclude=/path) also work.
EXCLUDE=()
# EXCLUDE=("cache" "tmp" "*.log" "/var/www/example/private/big")

# Extra directories to include in the same archive (optional)
EXTRA_SOURCE=()

# Override the global full-backup interval / mode for this job (optional)
#INTERVAL_DAYS=14
#FILE_MODE=incremental        # incremental | differential

#------ Database (cron_unidump backup db <name>) ------#
DBHOST='localhost'
DBNAME='example_db'           # several: 'db1,db2' (mysqldump only)
#DBUSER=''                    # empty = BACKUP_USER from the global config
#DBPASS=''                    # empty = BACKUP_PASS from the global config
DBENGINE='mysqldump'          # mysqldump | innodb (mydumper) | myisam (mysqlhotcopy)
DBOPTIONS='--single-transaction --routines --triggers'
